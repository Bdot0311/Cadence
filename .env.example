# =============================================================================
# Autonomous LinkedIn Agent — environment
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- LinkedIn app -----------------------------------------------------------
# From https://www.linkedin.com/developers/apps → your app → Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match the redirect URI registered on the app's Auth tab byte-for-byte,
# including trailing slash (or lack of one). A mismatch fails OAuth with an
# unhelpful error.
LINKEDIN_REDIRECT_URI=http://localhost:8080/auth/linkedin/callback

# Sent on EVERY request as the LinkedIn-Version header. Format YYYYMM.
# Bumping this is a deliberate, tested change — LinkedIn ships breaking changes
# between versions. Do not set it to "latest" or compute it from the clock.
LINKEDIN_API_VERSION=202608

# v1 requests these only. Both are self-serve Open Permissions.
#   w_member_social            — publish to the personal profile
#   openid profile email       — Sign In with LinkedIn (OIDC), to get author URN
# Do NOT add w_organization_social / r_organization_social here — they require
# Community Management API approval and are deferred to v2. See LIMITS.md.
LINKEDIN_SCOPES="openid profile email w_member_social"


# --- LinkedIn app 2: Community Management (v2) ------------------------------
# Community Management API requires that it be the ONLY product on its app.
# It cannot share an app with Share on LinkedIn — the console greys out the
# request button. So this is a SECOND, separate developer app.
#
# Leave blank until you have created that app and been granted access.
# A refresh token can only be redeemed with the credentials of the app that
# issued it, so these are never interchangeable with the pair above.
LINKEDIN_CMA_CLIENT_ID=
LINKEDIN_CMA_CLIENT_SECRET=
# Register this on app 2's Auth tab. Must differ from the primary redirect so
# the callback can tell the two flows apart.
LINKEDIN_CMA_REDIRECT_URI=http://localhost:8080/auth/linkedin/community/callback
# Community Management grants these. Do NOT add w_member_social here; it lives
# on app 1 and cannot be provisioned on this one.
LINKEDIN_CMA_SCOPES="r_organization_social w_organization_social"

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
# Dashboard (browser) uses the anon key. RLS applies.
SUPABASE_ANON_KEY=
# Worker + API use the service role key. Bypasses RLS by design.
# Server-side only. If this reaches the browser bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Key for pgcrypto token encryption at rest. 32+ random bytes, base64.
# The dashboard Settings page generates this automatically on first save.
# It is passed only through service-role RPC calls and is never exposed to the browser.
# Rotating this requires re-encrypting every stored token. There is no
# migration path that does it for you.
TOKEN_ENCRYPTION_KEY=


# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# Generation, classification, and gating all run on this model.
# Sonnet 5 notes that matter here:
#   - adaptive thinking is ON by default; max_tokens caps thinking + text
#     together, so leave headroom
#   - temperature / top_p / top_k are REJECTED (400). Steer with prompting.
#   - new tokenizer counts ~30% more tokens than Sonnet 4.6 for the same text
ANTHROPIC_MODEL=claude-sonnet-5

# low | medium | high | xhigh | max. Default is high.
# The slop and fact gates run at high; drafting runs at medium unless a retry
# loop escalates it.
ANTHROPIC_EFFORT=high


# --- Agent control ----------------------------------------------------------
# Halts ALL outbound writes immediately when true. Checked every scheduler tick
# (max 15 min to take effect) and before every individual publish. The
# dashboard button sets the same flag in agent_config; either one halts.
AGENT_KILL_SWITCH=false

# true  — full pipeline, no publishes, everything logged
# false — publishes for real
# Independently, agent_config.dry_run_until forces dry-run for the first 7 days
# after install regardless of this value. Whichever is more restrictive wins.
AGENT_DRY_RUN=true

# Scheduler tick interval. 15 min is the design point; the windowing and
# jitter logic assumes ticks are frequent enough to hit a target minute.
SCHEDULER_INTERVAL_MINUTES=15

# Hard ceiling on personal-profile writes per day. LinkedIn's documented limit
# is ~100/day/member. Budgeted below it on purpose — the ledger blocks at this
# number, not at LinkedIn's.
DAILY_WRITE_BUDGET=80

# Anomaly halt: if publish failures exceed this fraction in a rolling hour,
# stop writing and alert rather than retrying blind. Any 401/403 halts
# immediately regardless of this threshold.
ANOMALY_FAILURE_THRESHOLD=0.20

# Keep this many generated drafts stocked in the approval queue. Ideation runs
# at worker startup and then on this interval, but does nothing when the queue
# already meets the target.
IDEATION_QUEUE_TARGET=3
IDEATION_INTERVAL_HOURS=6
# When true, saved source posts and the extracted voice profile are sent to the
# configured Anthropic model to generate and critique drafts.
IDEATION_ENABLED=false


# --- Organization features (v2, Community Management API) -------------------
# Gates company-page publishing, comment reading, comment replies, webhooks,
# and org analytics. Leave false until LinkedIn grants Community Management API.
#
# Turning this on is NOT sufficient by itself. The token must also carry
# w_organization_social / r_organization_social, and adding the product in the
# LinkedIn developer console does NOT upgrade an existing token — reconnect the
# account to re-run OAuth. The client checks the granted scope and fails with a
# clear local error rather than a 403 that would trip the anomaly halt.
ORG_FEATURES_ENABLED=false

# --- Email (digest + alerts) ------------------------------------------------
# Daily digest: what published, what got killed at the gates and why,
# quota consumption, anything that errored.
# Also the destination for token-refresh failures and anomaly halts.
RESEND_API_KEY=
ALERT_EMAIL_TO=sales@alephwave.io
ALERT_EMAIL_FROM=agent@outreign.io


# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
API_PORT=8080
# Public origin of the API, used to build the OAuth redirect and any callback
# URLs registered with LinkedIn.
API_PUBLIC_URL=http://localhost:8080
DASHBOARD_URL=http://localhost:5173
# HMAC key for short-lived LinkedIn OAuth state. Generate independently from
# the token-encryption key: openssl rand -base64 32
OAUTH_STATE_SECRET=
LOG_LEVEL=info

# Dashboard Vite variables. These are public by design; RLS and bearer auth are
# the security boundary. Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8080
